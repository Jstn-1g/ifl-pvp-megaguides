---
import { NAVIGATION, SITE } from '../utils/site';
import { PUBLIC_CONTENT } from '../data/public-content';

const currentPath = Astro.url.pathname;
const isCurrent = (href: string) => href === '/guides/'
  ? currentPath.startsWith('/guides/') || PUBLIC_CONTENT.some((entry) => currentPath === `/${entry.route.slug}/`)
  : currentPath.startsWith(href);
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand-lockup" href="/" aria-label={`${SITE.name} home`}>
      <span class="brand-lockup__mark" aria-hidden="true">
        <img
          src="/brand/ifl-pvp-logo.webp"
          alt=""
          width="400"
          height="400"
          decoding="async"
          data-public-brand-asset="ifl-pvp-logo"
        />
      </span>
      <span class="brand-lockup__copy">
        <span>IFL PvP</span>
        <strong>MegaGuides</strong>
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary navigation">
      {NAVIGATION.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <button type="button" class="search-trigger" data-search-trigger aria-label="Search" aria-haspopup="dialog" aria-controls="site-search">
        <span aria-hidden="true">⌕</span><span>Search</span><kbd>Ctrl K</kbd>
      </button>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; z-index: 100; top: 0; min-height: var(--header-height); border-bottom: 1px solid var(--border-subtle); background: color-mix(in srgb, var(--bg-base) 90%, transparent); backdrop-filter: blur(18px); }
  .site-header__inner { display: flex; min-height: var(--header-height); align-items: center; justify-content: space-between; gap: 1.25rem; }
  .brand-lockup { display: inline-flex; flex: 0 0 auto; align-items: center; gap: 0.68rem; color: var(--text-bright); }
  .brand-lockup__mark { position: relative; display: grid; width: 2.65rem; height: 2.65rem; place-items: center; }
  .brand-lockup__mark::before { position: absolute; inset: 12%; border-radius: 50%; background: linear-gradient(135deg, rgba(74, 129, 203, 0.28), rgba(255, 173, 53, 0.25)); content: ''; filter: blur(9px); }
  .brand-lockup__mark img { position: relative; width: 100%; height: 100%; object-fit: contain; filter: drop-shadow(0 5px 12px rgba(0, 0, 0, 0.38)); }
  .brand-lockup__copy { display: grid; font-family: var(--font-display); font-size: 0.7rem; font-weight: 700; letter-spacing: 0.1em; line-height: 1.05; text-transform: uppercase; }
  .brand-lockup__copy span { color: var(--text-secondary); }
  .brand-lockup__copy strong { color: var(--text-bright); font-size: 0.88rem; letter-spacing: -0.025em; text-transform: none; }
  .site-header__nav { display: flex; min-width: 0; align-items: center; gap: 0.15rem; }
  .site-header__nav > a, .search-trigger { min-height: 44px; padding: 0.65rem 0.72rem; color: var(--text-secondary); font-family: var(--font-display); font-size: 0.77rem; font-weight: 650; letter-spacing: 0.015em; }
  .site-header__nav > a:hover, .site-header__nav > a[aria-current='page'] { color: var(--text-bright); }
  .site-header__nav > a[aria-current='page'] { box-shadow: inset 0 -2px 0 var(--accent); }
  .search-trigger { display: inline-flex; align-items: center; gap: 0.45rem; margin-left: 0.45rem; border: 1px solid var(--border-medium); background: transparent; }
  .search-trigger:hover { border-color: var(--accent); color: var(--text-bright); }
  .search-trigger span:first-child { color: var(--accent); font-size: 1.1rem; line-height: 0; }
  .search-trigger kbd { padding: 0.1rem 0.24rem; border: 1px solid var(--border-subtle); color: var(--text-muted); font: inherit; font-size: 0.6rem; }
  @media (max-width: 780px) {
    .site-header__inner { gap: 0.5rem; }
    .site-header__nav { max-width: calc(100vw - 11rem); overflow-x: auto; scrollbar-width: none; }
    .site-header__nav::-webkit-scrollbar { display: none; }
    .site-header__nav > a { padding-inline: 0.52rem; white-space: nowrap; }
    .search-trigger { margin-left: 0; padding-inline: 0.58rem; }
    .search-trigger kbd { display: none; }
  }
  @media (max-width: 480px) {
    .site-header__inner { flex-wrap: wrap; padding-block: 0.45rem; }
    .brand-lockup__copy span { display: none; }
    .brand-lockup__copy strong { font-size: 0.75rem; }
    .site-header__nav { width: 100%; max-width: none; flex-wrap: wrap; justify-content: flex-start; overflow: visible; }
    .site-header__nav > a { padding-inline: 0.35rem; font-size: 0.7rem; }
    .search-trigger { width: auto; min-width: 44px; flex: 0 0 auto; justify-content: center; padding-inline: 0.58rem; }
  }
</style>
