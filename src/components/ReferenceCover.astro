---
import type { GameKey } from '../data/public-content';

interface Props {
  title: string;
  eyebrow?: string | undefined;
  status?: string | undefined;
  index?: number | string | undefined;
  seed?: string | undefined;
  variant?: 'hero' | 'featured' | 'card' | 'compact' | 'social' | undefined;
  gameKey?: GameKey | undefined;
}

const {
  title,
  eyebrow = 'Competitive reference',
  status,
  index,
  seed = title,
  variant = 'card',
  gameKey,
} = Astro.props;

function stableVariant(value: string) {
  return [...value].reduce((total, character) => (total * 31 + character.charCodeAt(0)) >>> 0, 7) % 6;
}

const track = typeof index === 'number' ? (Math.max(1, index) - 1) % 6 : stableVariant(seed);
const indexLabel = typeof index === 'number' ? String(index).padStart(2, '0') : index;
---

<!-- Decorative duplicate of adjacent text content; all guide meaning remains in HTML outside this cover. -->
<div class:list={['reference-cover', `reference-cover--${variant}`]} data-reference-track={track} data-game={gameKey} aria-hidden="true">
  <span class="reference-cover__motif"></span>
  <span class="reference-cover__flare"></span>
  <span class="reference-cover__corner reference-cover__corner--top"></span>
  <span class="reference-cover__corner reference-cover__corner--bottom"></span>
  <span class="reference-cover__axis"></span>
  <span class="reference-cover__index">{indexLabel ?? 'REF'}</span>
  <span class="reference-cover__eyebrow">{eyebrow}</span>
  <span class="reference-cover__title">{title}</span>
  {status && <span class="reference-cover__status">{status}</span>}
  <span class="reference-cover__coordinates">IFL / FIELD / {String(track + 1).padStart(2, '0')}</span>
  <span class="reference-cover__art-note">Game media under review</span>
</div>

<style>
  .reference-cover {
    --cover-accent: var(--accent);
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    min-height: 100%;
    min-width: 0;
    width: 100%;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(0.75rem, 3.3cqw, 1.5rem);
    border: 1px solid color-mix(in srgb, var(--cover-accent) 42%, var(--border-medium));
    background:
      linear-gradient(112deg, color-mix(in srgb, var(--cover-accent) 18%, transparent), transparent 41%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.035), transparent 55%),
      var(--bg-surface);
    color: var(--text-bright);
    container-type: inline-size;
  }

  .reference-cover::before,
  .reference-cover::after {
    position: absolute;
    z-index: -1;
    inset: 0;
    background:
      radial-gradient(circle at 76% 34%, color-mix(in srgb, var(--cover-secondary) 38%, transparent), transparent 32%),
      linear-gradient(128deg, color-mix(in srgb, var(--cover-accent) 26%, transparent), transparent 46%);
    content: '';
    opacity: 0.9;
    transition: opacity 500ms var(--ease-out), transform 700ms var(--ease-out);
  }

  .reference-cover::after {
    background:
      linear-gradient(90deg, rgba(4, 9, 20, 0.89), rgba(4, 9, 20, 0.53) 58%, rgba(4, 9, 20, 0.16)),
      linear-gradient(180deg, rgba(4, 9, 20, 0.05) 34%, rgba(4, 9, 20, 0.82)),
      radial-gradient(circle at 72% 42%, color-mix(in srgb, var(--cover-secondary) 22%, transparent), transparent 38%);
    opacity: 1;
    transform: none;
  }

  .reference-cover[data-game='battlerite'] { --cover-accent: #b6e84b; --cover-secondary: #18a99b; --cover-base: #092e31; }
  .reference-cover[data-game='gigantic'] { --cover-accent: #bfeFea; --cover-secondary: #e96e50; --cover-base: #12345b; }
  .reference-cover[data-game='gunz'] { --cover-accent: #f04d28; --cover-secondary: #2f8ecd; --cover-base: #1b2730; }
  .reference-cover[data-game='marvel-rivals'] { --cover-accent: #42d66e; --cover-secondary: #e34d52; --cover-base: #172547; }
  .reference-cover[data-game='bloodline-champions'] { --cover-accent: #56dd9a; --cover-secondary: #7888ba; --cover-base: #2c353c; }

  .reference-cover { --cover-secondary: var(--accent-cool); --cover-base: var(--bg-surface); background: linear-gradient(145deg, color-mix(in srgb, var(--cover-base) 88%, #000), var(--cover-base)); }
  .reference-cover__motif,
  .reference-cover__flare { position: absolute; z-index: -2; pointer-events: none; }
  .reference-cover__flare { top: -28%; right: -10%; width: 62%; aspect-ratio: 1; border-radius: 50%; background: radial-gradient(circle, color-mix(in srgb, var(--cover-secondary) 38%, transparent), transparent 66%); filter: blur(14px); }
  .reference-cover__motif { right: 5%; bottom: 2%; width: 49%; aspect-ratio: 1; opacity: 0.62; transition: opacity 500ms var(--ease-out), transform 800ms var(--ease-out); }
  .reference-cover[data-game='battlerite'] .reference-cover__motif { border: 1px solid color-mix(in srgb, var(--cover-accent) 62%, transparent); border-radius: 50%; background: radial-gradient(circle, transparent 0 26%, color-mix(in srgb, var(--cover-secondary) 36%, transparent) 27% 29%, transparent 30% 47%, color-mix(in srgb, var(--cover-accent) 40%, transparent) 48% 50%, transparent 51%); box-shadow: 0 0 32px color-mix(in srgb, var(--cover-secondary) 24%, transparent); }
  .reference-cover[data-game='gigantic'] .reference-cover__motif { border-radius: 58% 42% 65% 35% / 44% 64% 36% 56%; background: radial-gradient(circle at 34% 32%, color-mix(in srgb, var(--cover-accent) 78%, transparent), transparent 28%), linear-gradient(145deg, color-mix(in srgb, var(--cover-secondary) 72%, transparent), transparent 68%); transform: rotate(-12deg); filter: blur(1px); }
  .reference-cover[data-game='gunz'] .reference-cover__motif { width: 55%; height: 72%; aspect-ratio: auto; background: repeating-linear-gradient(132deg, transparent 0 13%, color-mix(in srgb, var(--cover-accent) 72%, transparent) 13.5% 15%, transparent 15.5% 26%); transform: skewX(-12deg); }
  .reference-cover[data-game='marvel-rivals'] .reference-cover__motif { border-radius: 50%; background: conic-gradient(from 18deg, transparent 0 8%, color-mix(in srgb, var(--cover-accent) 70%, transparent) 8% 12%, transparent 12% 23%, color-mix(in srgb, var(--cover-secondary) 64%, transparent) 23% 28%, transparent 28% 42%, color-mix(in srgb, #fdb23e 65%, transparent) 42% 47%, transparent 47% 100%); filter: blur(0.5px); }
  .reference-cover[data-game='bloodline-champions'] .reference-cover__motif { border-radius: 50%; background: radial-gradient(circle at 22% 68%, var(--cover-accent) 0 3%, transparent 4%), radial-gradient(circle at 72% 24%, var(--cover-secondary) 0 4%, transparent 5%), radial-gradient(circle at 76% 78%, #f2a53c 0 3%, transparent 4%), conic-gradient(from 32deg, transparent 0 9%, color-mix(in srgb, var(--cover-secondary) 46%, transparent) 10% 11%, transparent 12% 38%, color-mix(in srgb, var(--cover-accent) 42%, transparent) 39% 40%, transparent 41%); border: 1px solid color-mix(in srgb, var(--cover-secondary) 34%, transparent); }

  .reference-cover__corner {
    position: absolute;
    width: 17%;
    height: 19%;
    border-color: var(--cover-accent);
    opacity: 0.8;
  }
  .reference-cover__corner--top { top: 0.55rem; right: 0.55rem; border-top: 1px solid; border-right: 1px solid; }
  .reference-cover__corner--bottom { bottom: 0.55rem; left: 0.55rem; border-bottom: 1px solid; border-left: 1px solid; }
  .reference-cover__axis { grid-row: 1 / -1; width: 2px; margin-right: clamp(0.55rem, 2.4cqw, 1rem); background: var(--cover-accent); box-shadow: 0 0 16px color-mix(in srgb, var(--cover-accent) 45%, transparent); }
  .reference-cover__index,
  .reference-cover__eyebrow,
  .reference-cover__coordinates,
  .reference-cover__status {
    font-family: var(--font-display);
    font-size: clamp(0.57rem, 3cqw, 0.75rem);
    font-weight: 700;
    letter-spacing: 0.13em;
    line-height: 1.1;
    text-transform: uppercase;
  }
  .reference-cover__index { grid-column: 2; color: var(--cover-accent); }
  .reference-cover__eyebrow { align-self: end; color: var(--text-secondary); }
  .reference-cover__title { align-self: center; max-width: 18ch; margin: 0.45rem 0; font-family: var(--font-display); font-size: clamp(1rem, 8cqw, 2.75rem); font-weight: 750; letter-spacing: -0.05em; line-height: 0.92; text-wrap: balance; }
  .reference-cover__status { position: absolute; right: clamp(0.75rem, 3.3cqw, 1.5rem); bottom: clamp(0.75rem, 3.3cqw, 1.5rem); color: var(--cover-accent); }
  .reference-cover__coordinates { align-self: end; color: var(--text-muted); }
  .reference-cover__art-note { position: absolute; top: clamp(0.75rem, 3.3cqw, 1.5rem); right: clamp(0.75rem, 3.3cqw, 1.5rem); padding: 0.35rem 0.45rem; border: 1px solid rgba(255, 255, 255, 0.22); background: rgba(4, 9, 20, 0.58); color: rgba(255, 255, 255, 0.78); font-family: var(--font-display); font-size: clamp(0.45rem, 2.3cqw, 0.62rem); font-weight: 750; letter-spacing: 0.1em; line-height: 1; text-transform: uppercase; backdrop-filter: blur(8px); }

  .reference-cover--compact { min-height: 7.5rem; }
  .reference-cover--compact .reference-cover__title { font-size: clamp(0.95rem, 8cqw, 1.4rem); }
  .reference-cover--card { aspect-ratio: 16 / 10; }
  .reference-cover--featured,
  .reference-cover--hero { aspect-ratio: 16 / 9; }
  .reference-cover--hero .reference-cover__title { max-width: 15ch; font-size: clamp(1.75rem, 8cqw, 4.2rem); }
  .reference-cover--social { aspect-ratio: 1200 / 630; }
  :global(.guide-card:hover) .reference-cover::before,
  :global(.guide-card:focus-within) .reference-cover::before { opacity: 1; transform: scale(1.04); }
  :global(.guide-card:hover) .reference-cover__motif,
  :global(.guide-card:focus-within) .reference-cover__motif { opacity: 0.84; transform: translate3d(-2%, -2%, 0) scale(1.05); }

  @media (prefers-reduced-motion: reduce) { .reference-cover::before, .reference-cover__motif { transition: none; } }
  @media (forced-colors: active) { .reference-cover__motif, .reference-cover__flare, .reference-cover__art-note { display: none; } }
</style>
