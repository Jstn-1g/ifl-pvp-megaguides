<script>
  const syncArenaVisibility = () => {
    document.documentElement.toggleAttribute('data-document-hidden', document.hidden);
  };

  syncArenaVisibility();
  document.addEventListener('visibilitychange', syncArenaVisibility, { passive: true });
</script>
