---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — IFL PvP MegaGuides" description="The requested IFL PvP MegaGuides page was not found." canonicalPath="/404/" noindex>
  <section class="page-hero" aria-labelledby="not-found-title">
    <div class="container prose">
      <p class="eyebrow">404 / Route unavailable</p>
      <h1 id="not-found-title">That field manual is not here.</h1>
      <p>The route may not be part of this small public release, may still be in evidence review, or may have moved. We do not replace a missing guide with a guessed answer.</p>
      <p><a class="button button--primary" href="/guides/">Browse retained routes</a></p>
    </div>
  </section>
</BaseLayout>
