---
import GuideCard from '../../components/GuideCard.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { PUBLIC_CONTENT } from '../../data/public-content';

const title = 'MegaGuides — Detailed Competitive Game References';
const description = 'Detailed historical and patch-pinned competitive-game references with mechanics, rosters, techniques, tables, sources, and visible scope limits.';
const retainedRouteCount: number = PUBLIC_CONTENT.length;
const retainedRouteLabel = new Intl.PluralRules('en-US').select(retainedRouteCount) === 'one' ? 'route' : 'routes';

function statusLabel(entry: (typeof PUBLIC_CONTENT)[number]) {
  return entry.publicationState === 'patch-snapshot' ? 'Patch snapshot' : 'Detailed reference';
}

function reviewLabel(entry: (typeof PUBLIC_CONTENT)[number]) {
  return entry.publicationState === 'patch-snapshot'
    ? `Patch review due ${entry.review.nextReviewAt}`
    : `Restored ${entry.restoration.restoredAt}`;
}
---

<BaseLayout {title} {description} canonicalPath="/guides/">
  <section class="page-hero" aria-labelledby="guides-title">
    <div class="container">
      <p class="eyebrow">IFL / MegaGuides</p>
      <h1 id="guides-title">The full reference bodies are back.</h1>
      <p class="page-hero__lede">{retainedRouteCount} detailed {retainedRouteLabel}, 40,696 words, and 923 data rows across mechanics, rosters, abilities, techniques, history, and strategy—with historical and patch scope kept visible.</p>
    </div>
  </section>

  <section class="section section--library" aria-label="Retained guide routes">
    <div class="container">
      {PUBLIC_CONTENT.length > 0 ? (
        <div class="guide-grid">
          {PUBLIC_CONTENT.map((entry, index) => (
            <GuideCard
              href={`/${entry.route.slug}/`}
              title={entry.title}
              description={entry.description}
              game={entry.game}
              gameKey={entry.gameKey}
              index={index + 1}
              status={entry.publicationState === 'patch-snapshot' ? 'review-due' : 'stable-reference'}
              statusLabel={statusLabel(entry)}
              reviewedLabel={reviewLabel(entry)}
              gameVersion={entry.gameVersion}
              sourceCount={entry.sources.length}
              readingTime={`${Math.max(1, Math.ceil(entry.stats.wordCount / 225))} min read`}
            />
          ))}
        </div>
      ) : (
        <div class="empty-state prose">
          <h2>No guides are ready to list.</h2>
          <p>A public guide route appears only after its evidence state is recorded.</p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
